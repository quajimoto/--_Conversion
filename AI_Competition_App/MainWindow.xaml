<Window x:Class="AI_Competition_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI_Competition_App"
        xmlns:views="clr-namespace:AI_Competition_App.Views"
        xmlns:viewmodels="clr-namespace:AI_Competition_App.ViewModels"
        mc:Ignorable="d"
        Title="사내 경진대회 평가 시스템" MinHeight="768" Width="1024" SizeToContent="Height"
        FontFamily="Noto Sans" Background="#F8FAFB">
    
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- DataTemplate routing -->
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EvaluationViewModel}">
            <views:EvaluationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>

        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1A6477"/>
                    <Setter Property="Background" Value="#101A6477"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#1A6477"/>
                    <Setter Property="BorderBrush" Value="#1A6477"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#101A6477"/>
                    <Setter Property="Foreground" Value="#1A6477"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Nav Bar -->
        <Border Grid.Row="0" Background="#E8F4F8" BorderBrush="#D0E3EA" BorderThickness="0,0,0,1">
            <Grid Height="56" MaxWidth="1440" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Brand -->
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/shc_logo.png" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                
                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton Content="평가 입력" Command="{Binding ShowEvaluationCommand}" Style="{StaticResource NavTabStyle}" IsChecked="True" GroupName="NavGroup"/>
                    <RadioButton Content="관리자 현황" Command="{Binding ShowAdminCommand}" Style="{StaticResource NavTabStyle}" GroupName="NavGroup"
                                 Visibility="{Binding IsAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Trailing Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="평가자" FontSize="14" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,16,0"
                               Visibility="{Binding IsAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="로그아웃" Command="{Binding LogoutCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="로그아웃"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
