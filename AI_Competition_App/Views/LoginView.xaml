<UserControl x:Class="AI_Competition_App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AI_Competition_App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1024"
             FontFamily="Noto Sans" Background="#F8FAFB">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0E3EA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1A6477"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0E3EA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1A6477"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1A6477"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E667A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Border Background="#FFFFFF" BorderBrush="#D0E3EA" BorderThickness="1" CornerRadius="12" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="4"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Header Area -->
                <Border Background="#E8F4F8" BorderBrush="#D0E3EA" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="32,24">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" Background="#FFFFFF" BorderBrush="#D0E3EA" BorderThickness="1" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <TextBlock Text="C" FontSize="28" FontWeight="Bold" Foreground="#1A6477" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AI 경진대회 평가 시스템" FontSize="24" FontWeight="Bold" Foreground="#1A6477" HorizontalAlignment="Center"/>
                        <TextBlock Text="사내 경진대회 평가" FontSize="14" Foreground="#666666" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Content Area -->
                <StackPanel Margin="32">
                    
                    <!-- Mode Toggle (Visual Only for now based on Binding) -->
                    <Border Background="#ECEEEF" CornerRadius="8" Padding="4" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="{Binding IsSimpleMode, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="6">
                                <TextBlock Text="단순 모드" FontSize="12" FontWeight="SemiBold" Foreground="#1A6477" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"/>
                            </Border>
                            <Border Grid.Column="1" Background="{Binding IsSecureMode, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="6">
                                <TextBlock Text="보안 모드" FontSize="12" FontWeight="SemiBold" Foreground="#1A6477" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- SIMPLE 모드 -->
                    <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="평가자 이름" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding UserList}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="UserName" 
                                  Height="44" FontSize="14" Padding="12,10" VerticalContentAlignment="Center" Margin="0,0,0,16"
                                  Background="#FFFFFF" BorderBrush="#D0E3EA">
                        </ComboBox>
                        <Button Command="{Binding LoginCommand}" Content="입장하기" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- SECURE 모드 -->
                    <StackPanel Visibility="{Binding IsSecureMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="사번" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding UserId}" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="비밀번호" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8"/>
                        <PasswordBox Margin="0,0,0,16"/>
                        
                        <Button Command="{Binding LoginCommand}" Content="로그인" Margin="0,8,0,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="승인된 인원만 접근 가능합니다.&#x0a;접속 문제가 있을 경우 시스템 관리자에게 문의하세요." 
                               FontSize="11" Foreground="#666666" TextAlignment="Center" Margin="0,24,0,0" LineHeight="18"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
