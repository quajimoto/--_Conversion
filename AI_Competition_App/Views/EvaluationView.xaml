<UserControl x:Class="AI_Competition_App.Views.EvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AI_Competition_App.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1024"
             Background="#F8FAFB" FontFamily="Noto Sans">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0E3EA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1A6477"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0E3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F4F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1A6477"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E667A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable Main Content -->
        <ScrollViewer Grid.Row="0" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1400" HorizontalAlignment="Center" Width="Auto" MinWidth="800">
                
                <!-- Page Header & Controls -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="부서별 평가 입력" FontSize="24" FontWeight="Bold" Foreground="#1A6477" VerticalAlignment="Center"/>
                        <TextBlock Text="현재 리뷰 주기에 대한 점수를 입력하세요. 실무적 만점 제한이 적용됩니다." FontSize="14" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" 
                              HorizontalAlignment="Stretch" Margin="0,0,16,0" Height="40" FontSize="14" Padding="12,8" VerticalContentAlignment="Center"
                              IsEnabled="{Binding IsNotReadOnly}"
                              Background="#FFFFFF" BorderBrush="#D0E3EA">
                    </ComboBox>
                    
                    <Border Grid.Column="2" Background="#ECEEEF" BorderBrush="#D0E3EA" BorderThickness="1" CornerRadius="16" Padding="12,4" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#70787C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="입력 모드" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DataGrid Container (Bento/Card Style) -->
                <Border Background="#FFFFFF" BorderBrush="#D0E3EA" BorderThickness="1" CornerRadius="8" 
                        IsEnabled="{Binding IsNotReadOnly}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="4"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#E8F4F8" BorderBrush="#D0E3EA" BorderThickness="0,0,0,1" Height="40" Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="평가 대상 부서" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="실무 적용&#x0A;가능성 (210)" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="업무 효율&#x0A;개선효과 (210)" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="창의성·&#x0A;혁신성 (140)" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="확산&#x0A;가능성 (140)" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="총점&#x0A;(700)" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Table Body Row (Single Department) -->
                        <Border BorderBrush="#E6E8E9" BorderThickness="0,0,0,1" Padding="16,12" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Department Label -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="4" Background="#3A7D91" Opacity="0.2" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding SelectedDepartment, TargetNullValue='부서를 선택하세요'}" FontSize="14" Foreground="#191C1D" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Inputs -->
                                <TextBox Grid.Column="1" Text="{Binding InputPracticalScore, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Right"/>
                                <TextBox Grid.Column="2" Text="{Binding InputEfficiencyScore, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Right"/>
                                <TextBox Grid.Column="3" Text="{Binding InputInnovationScore, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Right"/>
                                <TextBox Grid.Column="4" Text="{Binding InputScalabilityScore, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Right"/>
                                
                                <!-- Total -->
                                <TextBlock Grid.Column="5" Text="{Binding TotalScore}" FontSize="16" FontWeight="Bold" Foreground="#1A6477" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        
                        <!-- Evaluated History Rows -->
                        <ItemsControl ItemsSource="{Binding EvaluatedHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E6E8E9" BorderThickness="0,0,0,1" Padding="16,12" Background="#FAFAFA">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="4" Background="#70787C" Opacity="0.2" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding DepartmentName}" FontSize="14" Foreground="#666666" VerticalAlignment="Center"/>
                                                <Border Margin="12,0,0,0" Padding="8,2" Background="#E8F4F8" CornerRadius="12" VerticalAlignment="Center">
                                                    <TextBlock Text="평가완료" FontSize="11" Foreground="#1A6477" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding ScorePractical}" FontSize="14" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreEfficiency}" FontSize="14" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ScoreInnovation}" FontSize="14" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ScoreScalability}" FontSize="14" Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                            
                                            <TextBlock Grid.Column="5" Text="{Binding TotalScore}" FontSize="16" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Table Footer Summary -->
                        <Border Background="#F2F4F5" Height="40" Padding="16,0">
                            <Grid>
                                <TextBlock Text="현재 선택된 부서에 대한 1개의 평가 항목" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="부서 평가 총점: " FontSize="12" Foreground="#666666"/>
                                    <TextBlock Text="{Binding TotalScore}" FontSize="16" FontWeight="Bold" Foreground="#1A6477" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Footer Actions -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0E3EA" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid MaxWidth="1400" HorizontalAlignment="Center" Width="Auto" MinWidth="800">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="평가 후 최종 제출을 완료해야 집계에 반영됩니다." FontSize="12" Foreground="#666666"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 임시 저장 (옵션) -->
                    <Button Command="{Binding SaveTempCommand}" Content="임시 저장" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0"
                            Visibility="{Binding IsNotReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            
                    <!-- 다음 부서 버튼 -->
                    <Button Command="{Binding NextCommand}" Content="다음 ➔" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,16,0"
                            Visibility="{Binding IsNotLastDepartment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            
                    <!-- 최종 제출 버튼 -->
                    <Button Command="{Binding SubmitCommand}" Content="최종 제출" Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding IsLastDepartment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
